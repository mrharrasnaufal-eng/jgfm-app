<?xml version="1.0" encoding="utf-8"?>
<!--
  Collapsed custom notification content (DramaBox-style).
  Android 12+ (targetSdk 31+) caps collapsed custom content height at 48dp —
  content must fit inside this box. Text colors use system theme attrs so they
  stay readable on any OEM background (dark/light).
-->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="48dp"
    android:padding="4dp"
    android:background="@android:color/transparent">

    <!-- Poster thumbnail kiri -->
    <ImageView
        android:id="@+id/notif_poster"
        android:layout_width="28dp"
        android:layout_height="40dp"
        android:layout_alignParentStart="true"
        android:layout_centerVertical="true"
        android:scaleType="centerCrop"
        android:src="@mipmap/ic_launcher"
        android:contentDescription="poster" />

    <!-- Tombol Tonton kanan -->
    <TextView
        android:id="@+id/notif_button"
        android:layout_width="wrap_content"
        android:layout_height="24dp"
        android:layout_alignParentEnd="true"
        android:layout_centerVertical="true"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:gravity="center"
        android:text="Tonton"
        android:textColor="#FFFFFF"
        android:textSize="11sp"
        android:textStyle="bold"
        android:background="@drawable/bg_button_pink" />

    <!-- Teks tengah -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_toEndOf="@id/notif_poster"
        android:layout_toStartOf="@id/notif_button"
        android:layout_centerVertical="true"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/notif_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Judul Drama"
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="13sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/notif_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:text="Deskripsi notifikasi"
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="11sp"
            android:maxLines="1"
            android:ellipsize="end" />

    </LinearLayout>

</RelativeLayout>
